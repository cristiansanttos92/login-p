{
  "name": "login-p-didatico",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm:dev --workspace=server\" \"npm:dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "start:api": "npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
